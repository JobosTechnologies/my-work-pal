# My Work Pal voice worker configuration.
# Names only: copy to .env (or set in the host's secret store) and fill
# in locally. Never commit real values.

# LiveKit project (required to run the worker at all)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech and conversation (see voice/mwp_voice/voice_config.py and
# docs/voice-options.md)
MWP_STT_MODEL=
MWP_TTS_MODEL=
MWP_TTS_VOICE=
MWP_CONVERSATION_MODE=
MWP_LLM_MODEL=

# Who the assistant is on a call
MWP_ASSISTANT_NAME=
MWP_BUSINESS_NAME=
MWP_OWNER_NAME=

# Outbound calling (WP7): either an outbound SIP trunk that already
# exists in the LiveKit project...
MWP_OUTBOUND_TRUNK_ID=
# ...or the carrier SIP settings (SignalWire) the worker uses to create
# the trunk at start. All four are required together. MWP_CALLER_ID is
# the owner's number on the carrier: the number outbound calls come from.
MWP_SIP_TRUNK_ADDRESS=
MWP_SIP_USERNAME=
MWP_SIP_PASSWORD=
MWP_CALLER_ID=
